{
  "info": {
    "name": "Countersign console API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Console API for Countersign. Set baseUrl and adminToken (printed by `countersign token`). Agents use the MCP endpoint /mcp/{key}/ instead."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8484"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "intentId",
      "value": ""
    },
    {
      "key": "agentId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Status",
      "item": [
        {
          "name": "Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "status"
              ]
            },
            "description": "Backend, gateway and AI status. No auth needed."
          }
        },
        {
          "name": "Summary (24h)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "summary"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Money trail",
      "item": [
        {
          "name": "All intents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/intents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "intents"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Held intents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/intents?status=held",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "intents"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "held"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "One intent",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/intents/{{intentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "intents",
                "{{intentId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Countersign a hold",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/intents/{{intentId}}/decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "intents",
                "{{intentId}}",
                "decision"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approve\": true,\n  \"via\": \"console\"\n}"
            }
          }
        },
        {
          "name": "Deny a hold",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/intents/{{intentId}}/decision",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "intents",
                "{{intentId}}",
                "decision"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approve\": false,\n  \"via\": \"console\"\n}"
            }
          }
        },
        {
          "name": "Ask the money trail (Claude)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/ask-grid",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ask-grid"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"held payouts over $20\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Agents",
      "item": [
        {
          "name": "List agents",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agents"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Supported clients",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clients"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Create agent",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agents",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agents"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kiln support desk\",\n  \"client\": \"claude-code\",\n  \"mandate\": {\n    \"auto_approve_up_to\": \"25.00\",\n    \"payout_allowlist\": [\n      \"payouts@kiln-supplies.example.com\"\n    ]\n  }\n}"
            }
          }
        },
        {
          "name": "Update mandate",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agents",
                "{{agentId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mandate\": {\n    \"auto_approve_up_to\": \"10.00\",\n    \"daily_limit\": \"100.00\"\n  }\n}"
            }
          }
        },
        {
          "name": "Pause agent",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agents",
                "{{agentId}}"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}"
            }
          }
        },
        {
          "name": "Rotate key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/agents/{{agentId}}/rotate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "agents",
                "{{agentId}}",
                "rotate"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Test payments",
      "item": [
        {
          "name": "Create test payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/test-payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "test-payments"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"50.00\",\n  \"currency\": \"USD\",\n  \"description\": \"Countersign test payment\"\n}"
            }
          }
        },
        {
          "name": "Capture after sandbox approval",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/test-payments/{{orderId}}/capture",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "test-payments",
                "{{orderId}}",
                "capture"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Chaos bench",
      "item": [
        {
          "name": "Latest results",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bench",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bench"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Run the bench",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bench/run",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bench",
                "run"
              ]
            },
            "description": ""
          }
        }
      ]
    }
  ]
}
