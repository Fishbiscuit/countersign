# Countersign configuration. Copy to .env and fill in.

# Required: which PayPal backend to use. No silent fallback between them.
#   sandbox    real PayPal Sandbox REST API, test money (the hackathon submission path)
#   simulated  no PayPal calls at all; labelled "Simulated PayPal" everywhere
COUNTERSIGN_BACKEND=simulated

# PayPal Sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: sandbox webhook ID, for PayPal-signed confirmations at /webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Optional: Claude explains held money moves and powers "Ask the money trail". Choose where Claude comes from:
#   claude-code  the Claude Code CLI on this machine, on its own sign-in (no API key; for a local demo)
#   anthropic    the Anthropic API with ANTHROPIC_API_KEY (for a deployment; the default when a key is set)
#   off          no AI (the default without a key)
COUNTERSIGN_EXPLAINER=
ANTHROPIC_API_KEY=

# Where agents and phones reach this Countersign (set to your https URL when deployed)
COUNTERSIGN_PUBLIC_URL=http://127.0.0.1:8484
# Seconds an agent waits for a human before a held move expires (fail-closed)
COUNTERSIGN_APPROVAL_TIMEOUT=90
# Mount the demo shop inbox (tickets + orders) for demos
COUNTERSIGN_DEMO_SHOP=1

# Optional: model for hold explanations and "Ask the money trail" with the Anthropic API (default claude-opus-5-5)
COUNTERSIGN_EXPLAINER_MODEL=
# Optional: model with Claude Code (default: Claude Code's own default). The model that answered is shown on each note
COUNTERSIGN_CLAUDE_CODE_MODEL=
